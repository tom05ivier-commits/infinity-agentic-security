{
  "version": 1,
  "license": "Tom05ivier-commits-1.0",
  "owner": "Tomi vier",
  "note": "Daftar semua server yang dikelola supervisor. Tambah entri di sini bila ada komponen baru yang membutuhkan server.",
  "services": [
    {
      "name": "server",
      "kind": "http",
      "port": 8765,
      "health": "/api/health",
      "command": [
        "python3",
        "system/cli.py",
        "serve",
        "--host",
        "127.0.0.1",
        "--port",
        "8765"
      ]
    },
    {
      "name": "protection",
      "kind": "process",
      "command": [
        "python3",
        "system/cli.py",
        "protect",
        "--seconds",
        "3600",
        "--interval",
        "0.5"
      ]
    },
    {
      "name": "bridge",
      "kind": "http",
      "port": 8766,
      "health": "/v1/health",
      "command": [
        "python3",
        "copilot-bridge/bridge.py"
      ]
    },
    {
      "name": "files",
      "kind": "http",
      "port": 8767,
      "health": "/",
      "command": [
        "python3",
        "system/fileserver.py",
        "8767"
      ]
    },
    {
      "name": "public",
      "kind": "http",
      "port": 8768,
      "health": "/",
      "command": [
        "python3",
        "system/public_server.py",
        "8768"
      ]
    },
    {
      "name": "tunnel",
      "kind": "process",
      "command": [
        "bash",
        "system/tunnel.sh"
      ]
    },
    {
      "name": "workflow",
      "kind": "process",
      "command": [
        "bash",
        "security/workflow-daemon.sh"
      ]
    },
    {
      "name": "sites",
      "kind": "http",
      "command": [
        "python3",
        "site/server.py",
        "8769"
      ],
      "port": 8769,
      "health": "/health"
    },
    {
      "name": "mirror",
      "kind": "http",
      "command": [
        "python3",
        "site/mirror_server.py",
        "8770"
      ],
      "port": 8770,
      "health": "/health"
    },
    {
      "name": "community",
      "kind": "http",
      "command": [
        "python3",
        "site/community/server.py"
      ],
      "port": 8781,
      "health": "/health"
    },
    {
      "name": "symphony",
      "kind": "process",
      "command": [
        "bash",
        "scripts/symphony-deploy.sh"
      ]
    },
    {
      "name": "tom05-provider",
      "kind": "http",
      "command": [
        "python3",
        "system/tom05_provider.py"
      ],
      "port": 8772,
      "health": "/health",
      "container": "tom05-inference",
      "container_network": "agenty-net",
      "manager": "infinity",
      "manager_endpoint": "http://infinity:8766/v1/chat/completions",
      "managed_by": "supervisor"
    },
    {
      "name": "port-14713",
      "kind": "monitor",
      "command": [
        "true"
      ],
      "port": 14713
    },
    {
      "name": "chat-dispatch",
      "kind": "process",
      "command": [
        "python3",
        "system/chat_dispatch.py",
        "daemon"
      ]
    },
    {
      "name": "tom05-selfhost",
      "kind": "http",
      "command": [
        "python3",
        "system/tom05_selfhost.py"
      ],
      "port": 8773,
      "health": "/health"
    },
    {
      "name": "service-watch",
      "kind": "http",
      "command": [
        "python3",
        "system/service_watch.py",
        "serve"
      ],
      "port": 8782,
      "health": "/health"
    },
    {
      "name": "sre-watch",
      "kind": "process",
      "command": [
        "python3",
        "system/sre_watch.py",
        "loop"
      ]
    },
    {
      "name": "ai-chip",
      "kind": "http",
      "command": [
        "python3",
        "system/ai_chip_service.py"
      ],
      "port": 8783,
      "health": "/health"
    },
    {
      "name": "ai-chip-watch",
      "kind": "process",
      "command": [
        "python3",
        "chip/chip_watch.py"
      ]
    },
    {
      "name": "domain",
      "kind": "http",
      "command": [
        "python3",
        "system/domain_service.py"
      ],
      "port": 8784,
      "health": "/health"
    },
    {
      "name": "permission-watch",
      "kind": "process",
      "command": [
        "python3",
        "security/permission_watch.py"
      ]
    },
    {
      "name": "opencode",
      "kind": "http",
      "command": [
        "bash",
        "scripts/opencode_serve.sh"
      ],
      "port": 8786,
      "health": "/health"
    },
    {
      "name": "cloud-code",
      "kind": "http",
      "command": [
        "python3",
        "system/cloud_code_service.py"
      ],
      "port": 8785,
      "health": "/health"
    },
    {
      "name": "opencode-42337",
      "kind": "http",
      "command": [
        "bash",
        "scripts/opencode_serve.sh",
        "42337"
      ],
      "port": 42337,
      "health": "/health"
    },
    {
      "name": "opencode-watch",
      "kind": "process",
      "command": [
        "python3",
        "system/opencode_watch.py",
        "loop"
      ]
    }
  ]
}